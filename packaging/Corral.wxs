<!--
  Installeur MSI de Corral (WiX 5) : Program Files\Corral, raccourci du menu Démarrer pour tous les utilisateurs.
  Compilé par .github/workflows/release.yml :
    wix build packaging/Corral.wxs -arch x64 -ext WixToolset.Util.wixext -d Version=X.Y.Z -d ExePath=publish/Corral.exe -o publish/Corral.msi
  Installation silencieuse : msiexec /i Corral.msi /qn
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Package Name="Corral" Manufacturer="Corral" Version="$(Version)"
           UpgradeCode="31D4CBD5-E6DE-4F73-A8C0-4205DD50BBB3" Scope="perMachine">
    <SummaryInformation Description="Corral - gestion des processus" />
    <MajorUpgrade DowngradeErrorMessage="Une version plus récente de Corral est déjà installée. / A newer version of Corral is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="corral.ico" SourceFile="$(sys.SOURCEFILEDIR)../src/Corral/corral.ico" />
    <Property Id="ARPPRODUCTICON" Value="corral.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/Captain-VII/Corral" />
    <Property Id="ARPHELPLINK" Value="https://github.com/Captain-VII/Corral/issues" />

    <!-- Ferme Corral (qui restaure priorités et plan d'alimentation à la fin de session) avant de remplacer ou supprimer l'exe -->
    <util:CloseApplication Id="CloseCorral" Target="Corral.exe" CloseMessage="no" EndSessionMessage="yes"
                           ElevatedEndSessionMessage="yes" TerminateProcess="0" Timeout="5" RebootPrompt="no" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Corral">
        <Component Id="CorralExe">
          <File Id="CorralExe" Source="$(ExePath)" KeyPath="yes">
            <Shortcut Id="CorralShortcut" Directory="ProgramMenuFolder" Name="Corral"
                      Description="Corral - gestion des processus" WorkingDirectory="INSTALLFOLDER" />
          </File>
          <!-- Restes d'une mise à jour automatique (voir Updater) -->
          <RemoveFile Id="OldExe" Name="Corral.exe.old" On="uninstall" />
          <RemoveFile Id="DownloadedExe" Name="Corral.exe.download" On="uninstall" />
          <!-- Lu par Installation.IsMsi -->
          <RegistryValue Root="HKLM" Key="SOFTWARE\Corral" Name="InstallDir" Type="string" Value="[INSTALLFOLDER]" />
        </Component>
      </Directory>
    </StandardDirectory>

    <!-- Désinstallation : supprime la tâche planifiée « Corral » (démarrage à l'ouverture de session) -->
    <SetProperty Id="RemoveAutoStart" Value="&quot;[System64Folder]schtasks.exe&quot; /delete /tn Corral /f"
                 Before="RemoveAutoStart" Sequence="execute" />
    <CustomAction Id="RemoveAutoStart" BinaryRef="Wix4UtilCA_X64" DllEntry="WixQuietExec"
                  Execute="deferred" Impersonate="no" Return="ignore" />
    <InstallExecuteSequence>
      <Custom Action="RemoveAutoStart" Before="RemoveFiles"
              Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
    </InstallExecuteSequence>

    <Feature Id="Main">
      <ComponentRef Id="CorralExe" />
    </Feature>
  </Package>
</Wix>
