<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>corral.ico</ApplicationIcon>
    <SatelliteResourceLanguages>fr</SatelliteResourceLanguages>

    <!-- Remplacée par le tag (vX.Y.Z) lors d'une release GitHub -->
    <Version>1.0.0</Version>
    <Product>Corral</Product>
    <Company>Corral</Company>
    <Copyright>Copyright © 2026 Captain VII — GPL-3.0</Copyright>
    <!-- Dépôt GitHub des mises à jour (propriétaire/nom). Le workflow de release le remplit automatiquement ;
         tant qu'il vaut OWNER/Corral, la mise à jour automatique est désactivée. -->
    <UpdateRepository Condition="'$(UpdateRepository)' == ''">OWNER/Corral</UpdateRepository>
    <!-- Seul l'exe publié en fichier unique peut se remplacer lui-même (voir Updater.IsSupported) -->
    <DefineConstants Condition="'$(PublishSingleFile)' == 'true'">$(DefineConstants);SINGLE_FILE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <!-- ServiceBase : mode service Windows (installation MSI) -->
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="corral.ico" LogicalName="Corral.corral.ico" />
    <AssemblyMetadata Include="UpdateRepository" Value="$(UpdateRepository)" />
  </ItemGroup>

</Project>
